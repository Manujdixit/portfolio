---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import config from "@/config";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title={`Projects | ${config.site.title}`}
  description={`Software projects by ${config.site.author}: full-stack web apps, backend services and tools.`}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Projects" pageDesc="Things I've built.">
    <ul>
      {projects.map(({ data }) => <ProjectCard {...data} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
