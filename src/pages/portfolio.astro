---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);
const featuredProjects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Portfolio | ${config.site.title}`}
  description={`${config.site.author}'s portfolio: work experience, projects and writing on web development, backend and AI.`}
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Portfolio
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      experience.length > 0 && (
        <section id="experience" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Experience</h2>
          <ul>
            {experience.map(({ data }) => (
              <li class="my-6">
                <h3 class="text-lg font-medium">
                  {data.role} ·{" "}
                  {data.url ? (
                    <a
                      href={data.url}
                      class="text-accent decoration-dashed underline-offset-4 hover:underline"
                    >
                      {data.company}
                    </a>
                  ) : (
                    <span class="text-accent">{data.company}</span>
                  )}
                </h3>
                <p class="text-sm opacity-80">{data.period}</p>
                <p class="mt-1">{data.summary}</p>
                {data.tech.length > 0 && (
                  <p class="mt-1 text-sm opacity-80">{data.tech.join(" · ")}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      features.showProjects && featuredProjects.length > 0 && (
        <section id="projects" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.nav.projects}
          </h2>
          <ul>
            {featuredProjects.map(({ data }) => (
              <ProjectCard variant="h3" {...data} />
            ))}
          </ul>
          <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
            {t.nav.projects}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
