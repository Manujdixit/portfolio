---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";

const home = await getEntry("pages", "home");

if (!home) {
  throw new Error(
    "Missing content entry: `home.md` or `home.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(home);
const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: config.site.author,
  url: config.site.url,
  jobTitle: "AI and Automation Engineer",
  worksFor: { "@type": "Organization", name: "IILM" },
  sameAs: socials.filter(s => s.name !== "mail").map(s => s.url),
};
---

<Layout
  title={`${config.site.author} | AI & Full-Stack Developer`}
  description={home.data.description}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pt-8 pb-12"
  >
    <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
      {home.data.title}
    </h1>
    <div class="app-prose">
      <Content />
    </div>
    {socials.length > 0 && <div class="mt-8"><Socials /></div>}
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
