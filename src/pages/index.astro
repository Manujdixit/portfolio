---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";

const home = await getEntry("pages", "home");

if (!home) {
  throw new Error(
    "Missing content entry: `home.md` or `home.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(home);
// "Hi" in the title gets the greeting animation; the rest stays static.
const titleRest = home.data.title.replace(/^Hi/, "");
const hasGreeting = titleRest !== home.data.title;
const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: config.site.author,
  url: config.site.url,
  jobTitle: "AI and Automation Engineer",
  worksFor: { "@type": "Organization", name: "IILM" },
  sameAs: socials.filter(s => s.name !== "mail").map(s => s.url),
};
---

<Layout
  title={`${config.site.author} | AI & Full-Stack Developer`}
  description={home.data.description}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pt-8 pb-12"
  >
    <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
      {
        hasGreeting ? (
          <>
            <span class="sr-only">Hi</span>
            <span
              id="greeting"
              aria-hidden="true"
              class="text-accent inline-block [perspective:400px]"
            >
              Hi
            </span>
            {titleRest}
          </>
        ) : (
          home.data.title
        )
      }
    </h1>
    <div class="app-prose [&_a]:text-accent [&_strong]:text-accent">
      <Content />
    </div>
    {
      socials.length > 0 && (
        <div class="mt-8">
          <Socials />
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  // Roll "Hi" through other languages once, then land back on "Hi". Each
  // letter flips up from below with a small stagger (keyframes below).
  const GREETINGS = [
    "नमस्ते",
    "Hola",
    "Bonjour",
    "Ciao",
    "こんにちは",
    "Hallo",
    "Hi",
  ];
  const STAGGER = 30; // ms between letters
  const ROLL = 200; // ms per letter
  const HOLD = 220; // ms a word stays fully visible

  // Devanagari conjuncts break if split, so keep that word whole.
  const letters = (word: string) =>
    /[ऀ-ॿ]/.test(word)
      ? [word]
      : Array.from(new Intl.Segmenter().segment(word), s => s.segment);

  function show(el: HTMLElement, word: string) {
    el.replaceChildren(
      ...letters(word).map((ch, i) => {
        const span = document.createElement("span");
        span.className = "greet-letter";
        span.textContent = ch;
        span.style.animation = `greet-in ${ROLL}ms ease-out ${i * STAGGER}ms both`;
        return span;
      })
    );
    return ROLL + (el.children.length - 1) * STAGGER;
  }

  function hide(el: HTMLElement) {
    Array.from(el.children as HTMLCollectionOf<HTMLElement>).forEach(
      (span, i) =>
        (span.style.animation = `greet-out ${ROLL}ms ease-in ${i * STAGGER}ms both`)
    );
    return ROLL + (el.children.length - 1) * STAGGER;
  }

  document.addEventListener("astro:page-load", () => {
    const greeting = document.querySelector<HTMLElement>("#greeting");
    if (!greeting || matchMedia("(prefers-reduced-motion: reduce)").matches)
      return;
    let i = 0;
    const step = () => {
      setTimeout(() => {
        const inTime = show(greeting, GREETINGS[i++]);
        if (i < GREETINGS.length) setTimeout(step, inTime + HOLD);
      }, hide(greeting));
    };
    show(greeting, "Hi");
    setTimeout(step, HOLD);
  });

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style is:global>
  .greet-letter {
    display: inline-block;
    white-space: pre;
  }
  @keyframes greet-in {
    from {
      transform: translateY(60%) rotateX(-90deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes greet-out {
    from {
      transform: none;
      opacity: 1;
    }
    to {
      transform: translateY(-60%) rotateX(90deg);
      opacity: 0;
    }
  }
</style>
