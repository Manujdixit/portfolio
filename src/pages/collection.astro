---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

// Redirect to 404 page if `showCollection` config is false
const notFoundUrl = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "404"
);
if (!config.features.showCollection && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const items = (await getCollection("collection")).sort(
  (a, b) => a.data.order - b.data.order
);

const sections = [
  {
    type: "watching",
    heading: "Movies I'd recommend",
    more: {
      href: "https://letterboxd.com/sensational_01/likes/films/",
      label: "For more, check my Letterboxd",
    },
  },
  { type: "listening", heading: "Favourite songs" },
  { type: "reading", heading: "Reading" },
] as const;
---

<Layout
  title={`Collection | ${config.site.title}`}
  description={`What ${config.site.author} is watching, listening to and reading right now, and why.`}
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Collection"
    pageDesc="What I'm watching, listening to and reading, and why I liked it."
  >
    {
      sections.map(section => {
        const { type, heading } = section;
        const more = "more" in section ? section.more : undefined;
        // Films: only the liked ones flagged `recommend`.
        const list = items.filter(
          ({ data }) =>
            data.type === type && (type !== "watching" || data.recommend)
        );
        return (
          list.length > 0 && (
            <section class="mb-10">
              <h2 class="text-2xl font-semibold tracking-wide">{heading}</h2>
              <ul>
                {list.map(({ data }) => (
                  <li class="my-6">
                    <h3 class="text-accent text-lg font-medium">
                      {data.url ? (
                        <a
                          href={data.url}
                          class="decoration-dashed underline-offset-4 hover:underline"
                        >
                          {data.title}
                        </a>
                      ) : (
                        data.title
                      )}
                    </h3>
                    {data.creator && (
                      <p class="text-sm opacity-80">{data.creator}</p>
                    )}
                    {data.why && <p class="mt-1">{data.why}</p>}
                  </li>
                ))}
              </ul>
              {more && (
                <p class="text-sm">
                  <a href={more.href} class="underline underline-offset-4">
                    {more.label}
                  </a>
                </p>
              )}
            </section>
          )
        );
      })
    }
  </Main>
  <Footer />
</Layout>
