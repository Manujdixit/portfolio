---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const items = (await getCollection("collection")).sort(
  (a, b) => a.data.order - b.data.order
);

// Listening is pulled live from Last.fm (connect Spotify to Last.fm first).
// The API key is a public, read-only key: https://www.last.fm/api/account/create
const LASTFM_USER = ""; // TODO: your Last.fm username
const LASTFM_API_KEY = ""; // TODO: your Last.fm API key

const sections = [
  {
    type: "watching",
    heading: "Watching",
    more: {
      href: "https://letterboxd.com/sensational_01/likes/films/",
      label: "Films I've liked on Letterboxd",
    },
  },
  { type: "listening", heading: "Listening" },
  { type: "reading", heading: "Reading" },
] as const;
---

<Layout
  title={`Collection | ${config.site.title}`}
  description={`What ${config.site.author} is watching, listening to and reading right now, and why.`}
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Collection"
    pageDesc="What I'm watching, listening to and reading, and why I liked it."
  >
    {
      sections.map(section => {
        const { type, heading } = section;
        const more = "more" in section ? section.more : undefined;
        const list = items.filter(({ data }) => data.type === type);
        if (type === "listening") {
          return (
            LASTFM_USER &&
            LASTFM_API_KEY && (
              <section
                id="listening"
                class="mb-10"
                data-user={LASTFM_USER}
                data-key={LASTFM_API_KEY}
                hidden
              >
                <h2 class="text-2xl font-semibold tracking-wide">{heading}</h2>
                <p class="mt-1 text-sm">
                  <a
                    href={`https://www.last.fm/user/${LASTFM_USER}`}
                    class="underline underline-offset-4"
                  >
                    More on Last.fm
                  </a>
                </p>
                <h3 id="lfm-now-label" class="mt-6 text-sm opacity-80" />
                <p id="lfm-now" class="text-accent text-lg font-medium" />
                <h3 class="mt-6 text-sm opacity-80">Most played, all time</h3>
                <ol id="lfm-top" class="mt-2 list-decimal ps-5" />
              </section>
            )
          );
        }
        return (
          list.length > 0 && (
            <section class="mb-10">
              <h2 class="text-2xl font-semibold tracking-wide">{heading}</h2>
              {more && (
                <p class="mt-1 text-sm">
                  <a href={more.href} class="underline underline-offset-4">
                    {more.label}
                  </a>
                </p>
              )}
              <ul>
                {list.map(({ data }) => (
                  <li class="my-6">
                    <h3 class="text-accent text-lg font-medium">
                      {data.url ? (
                        <a
                          href={data.url}
                          class="decoration-dashed underline-offset-4 hover:underline"
                        >
                          {data.title}
                        </a>
                      ) : (
                        data.title
                      )}
                    </h3>
                    {data.creator && (
                      <p class="text-sm opacity-80">{data.creator}</p>
                    )}
                    {data.why && <p class="mt-1">{data.why}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        );
      })
    }
  </Main>
  <Footer />
</Layout>

<script>
  type LastfmTrack = {
    name: string;
    url: string;
    playcount?: string;
    artist: { name?: string; "#text"?: string };
    "@attr"?: { nowplaying?: string };
  };

  function trackLink({ name, url, artist }: LastfmTrack) {
    const a = document.createElement("a");
    a.href = url;
    a.className = "decoration-dashed underline-offset-4 hover:underline";
    a.textContent = `${name} by ${artist.name ?? artist["#text"]}`;
    return a;
  }

  async function loadListening() {
    const section = document.querySelector<HTMLElement>("#listening");
    if (!section) return;
    const { user, key } = section.dataset;
    const api = (method: string, extra: string) =>
      fetch(
        `https://ws.audioscrobbler.com/2.0/?method=${method}&user=${user}&api_key=${key}&format=json&${extra}`
      ).then(res => res.json());

    try {
      const [recent, top] = await Promise.all([
        api("user.getrecenttracks", "limit=1"),
        api("user.gettoptracks", "period=overall&limit=3"),
      ]);
      const latest: LastfmTrack | undefined = recent.recenttracks?.track?.[0];
      const topTracks: LastfmTrack[] = top.toptracks?.track ?? [];
      if (!latest && topTracks.length === 0) return;

      if (latest) {
        const playing = latest["@attr"]?.nowplaying === "true";
        section.querySelector("#lfm-now-label")!.textContent = playing
          ? "Listening right now"
          : "Last played";
        section.querySelector("#lfm-now")!.replaceChildren(trackLink(latest));
      }
      section.querySelector("#lfm-top")!.replaceChildren(
        ...topTracks.map(track => {
          const li = document.createElement("li");
          li.className = "my-1";
          li.append(trackLink(track), ` · ${track.playcount} plays`);
          return li;
        })
      );
      section.hidden = false;
    } catch {
      // Last.fm down or misconfigured: keep the section hidden.
    }
  }

  document.addEventListener("astro:page-load", loadListening);
</script>
